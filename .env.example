# --- Netlify Function (server-side only, used by netlify dev / Netlify) ---
# Google Gemini key for the Setu Saathi chat. NEVER prefix with VITE_.
GEMINI_API_KEY=
# Optional, defaults to gemini-2.5-flash
# GEMINI_MODEL=gemini-2.5-flash
# Signs Verified Skill Badges — use any long random text
BADGE_SECRET=

# --- Frontend (optional) ---
# Point the site at the Express API in server/
# VITE_API_URL=http://localhost:4000/api
